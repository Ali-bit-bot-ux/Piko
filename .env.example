# Copy to .env.local and fill in. Never commit .env.local.

# Analysis provider: stub | claude | google
# "stub" is a fake provider for development. claude arrives in T-042, google in T-061.
ANALYSIS_PROVIDER=stub
ANTHROPIC_API_KEY=

# Storage: local | cloud (cloud arrives in T-061)
STORAGE=local
# Directory for local storage (ignored by git)
STORAGE_LOCAL_DIR=.data/storage

# Secret that signs login sessions. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Postgres connection string, e.g. postgresql://USER:PASSWORD@localhost:5432/piko
DATABASE_URL=
