# Copy to .env.local and fill in. Never commit .env.local.

# Analysis provider: stub | claude | gemini | groq
# "stub" is a fake provider for development.
ANALYSIS_PROVIDER=stub
# Backup when the main provider fails or hits its limit (same names, empty = none).
# Planned setup: ANALYSIS_PROVIDER=gemini and ANALYSIS_FALLBACK=groq.
ANALYSIS_FALLBACK=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
# Groq takes at most 5 pictures per request, so it looks at 5 frames of the video.
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
ANTHROPIC_API_KEY=
# Model for ANALYSIS_PROVIDER=claude (cheap by default, see docs/pricing.md)
ANTHROPIC_MODEL=claude-haiku-5-5

# Storage: local | cloud (cloud arrives in T-061)
STORAGE=local
# Directory for local storage (ignored by git)
STORAGE_LOCAL_DIR=.data/storage

# Public address of the site (used in registration links and QR codes)
APP_URL=http://localhost:3000

# Required in production (Auth.js refuses requests from an unknown host
# otherwise): the same address as APP_URL. Not needed for local development.
AUTH_URL=

# Secret that signs login sessions. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Postgres connection string, e.g. postgresql://USER:PASSWORD@localhost:5432/piko
DATABASE_URL=
